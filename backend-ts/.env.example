# Server Configuration
NODE_ENV=development
PORT=8000
FRONTEND_URL=http://localhost:5173

# Database
# For Neon: Use the pooler endpoint (includes PgBouncer)
# Example: postgresql://user:pass@ep-xxx-yyy.region.aws.neon.tech/dbname?sslmode=require
# For local dev: postgresql://sofem_user:sofem_password_dev@localhost:5432/sofem_mes
DATABASE_URL=postgresql://sofem_user:sofem_password_dev@localhost:5432/sofem_mes

# Authentication
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRES_IN=24h
JWT_COOKIE_NAME=sofem_session

# Frontend
SERVE_FRONTEND=false
