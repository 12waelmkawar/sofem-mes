{
  "name": "sofem-mes",
  "private": true,
  "workspaces": ["backend-ts", "frontend"],
  "scripts": {
    "dev:backend": "npm --workspace=backend-ts run dev",
    "dev:frontend": "npm --workspace=frontend run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:frontend": "npm --workspace=frontend run build",
    "build:backend": "npm --workspace=backend-ts run build",
    "build": "npm run build:backend && npm run build:frontend",
    "db:migrate": "npm --workspace=backend-ts run db:migrate",
    "db:seed": "npm --workspace=backend-ts run db:seed",
    "db:reset": "npm --workspace=backend-ts run db:reset"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
